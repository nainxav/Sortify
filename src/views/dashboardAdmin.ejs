            const popup = document.getElementById('ongoingPopup');
            popup.style.display = 'flex';
            
            const tableBody = document.getElementById('ongoingTableBody');
            tableBody.innerHTML = '';
            
            ongoingPickups.forEach(pickup => {
                const row = document.createElement('tr');
                
                row.innerHTML = `
                    <td>${pickup.id}</td>
                    <td>${pickup.location}</td>
                    <td>${pickup.estimatedWeight}</td>
                    <td>${formatDate(pickup.dateRequested)}</td>
                    <td>${pickup.currentStatus}</td>
                    <td><button class="btn-details" onclick="showTimeline('${pickup.id}')">Details</button></td>
                `;
                
                tableBody.appendChild(row);
            });
        }
        
        function showReceipt(pickupId) {
            const pickup = completedPickups.find(item => item.id === pickupId);
            if (!pickup) return;
            
            // Isi data receipt
            document.getElementById('receiptId').textContent = pickup.id;
            document.getElementById('receiptDate').textContent = formatDate(pickup.dateCompleted);
            document.getElementById('receiptLocation').textContent = pickup.location;
            document.getElementById('receiptOfficer').textContent = pickup.officer;
            document.getElementById('receiptWasteType').textContent = pickup.wasteType;
            document.getElementById('receiptWeight').textContent = `${pickup.weight} kg`;
            document.getElementById('receiptPricePerKg').textContent = `Rp ${pickup.pricePerKg.toLocaleString('id-ID')}`;
            
            const total = pickup.weight * pickup.pricePerKg;
            document.getElementById('receiptTotal').textContent = `Rp ${total.toLocaleString('id-ID')}`;
            
            document.getElementById('receiptPopup').style.display = 'block';
        }
        
        function showTimeline(pickupId) {
            const pickup = ongoingPickups.find(item => item.id === pickupId);
            if (!pickup) return;
            
            document.getElementById('timelineId').textContent = pickup.id;
            
            const timelineContainer = document.getElementById('timelineItems');
            timelineContainer.innerHTML = '';
            
            pickup.timeline.forEach((item, index) => {
                const timelineItem = document.createElement('div');
                timelineItem.className = `timeline-item ${item.current ? 'current-step' : ''}`;
                
                timelineItem.innerHTML = `
                    <div class="timeline-dot">${index + 1}</div>
                    <div class="timeline-content">
                        <div class="timeline-time">${formatDateTime(item.time)}</div>
                        <div class="timeline-status">${item.status}</div>
                        <div class="timeline-description">${item.description}</div>
                    </div>
                `;
                
                timelineContainer.appendChild(timelineItem);
            });
            
            const footer = document.querySelector('#timelinePopup .timeline-footer');
            const currentStatus = pickup.currentStatus.toLowerCase();
            
            if (currentStatus.includes('perjalanan')) {
                footer.textContent = "Petugas sedang dalam perjalanan untuk mengambil sampah Anda";
            } else if (currentStatus.includes('menunggu')) {
                footer.textContent = "Menunggu petugas tersedia untuk menjemput sampah Anda";
            } else {
                footer.textContent = "Proses pickup sedang berlangsung";
            }
            
            document.getElementById('timelinePopup').style.display = 'block';
        }
        
        function hideReceipt() {
            document.getElementById('receiptPopup').style.display = 'none';
        }
        
        function hideTimeline() {
            document.getElementById('timelinePopup').style.display = 'none';
        }
        
        function hidePopup(popupId) {
            document.getElementById(popupId).style.display = 'none';
        }
        
        function formatDate(dateString) {
            const options = { year: 'numeric', month: 'long', day: 'numeric' };
            return new Date(dateString).toLocaleDateString('id-ID', options);
        }
        
        function formatDateTime(dateTimeString) {
            const options = { 
                year: 'numeric', 
                month: 'short', 
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            };
            return new Date(dateTimeString.replace(' ', 'T')).toLocaleDateString('id-ID', options);
        }
        
        window.addEventListener('click', function(event) {
            if (event.target === document.getElementById('completedPopup')) {
                hidePopup('completedPopup');
            }
            
            if (event.target === document.getElementById('ongoingPopup')) {
                hidePopup('ongoingPopup');
            }
            
            if (event.target === document.getElementById('receiptPopup')) {
                hideReceipt();
            }
            
            if (event.target === document.getElementById('timelinePopup')) {
                hideTimeline();
            }
        });
    </script>

</body>
</html>